<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KinetiQ BLE Diagnostic — Band 6"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="stopped" />

        <TextView
            android:id="@+id/hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="" />

        <Button
            android:id="@+id/permissionBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1 · Request Bluetooth permissions" />

        <Button
            android:id="@+id/scanBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2 · Scan" />

        <Button
            android:id="@+id/bondedBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2B · Show bonded devices (a connected band can't be scanned)" />

        <EditText
            android:id="@+id/filterInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="name filter (e.g. band); empty = show all"
            android:inputType="text" />

        <ListView
            android:id="@+id/devices"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="4dp" />

        <Button
            android:id="@+id/connectBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="3 · Connect (manual only)" />

        <Button
            android:id="@+id/readBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="4 · Read documented standard characteristics" />

        <Button
            android:id="@+id/probeBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="5 · LPv2 plaintext probes (1/2, 1/3)" />

        <Button
            android:id="@+id/wearBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="6 · wearEngine probe (official channel via Health — consent dialog appears)" />

        <Button
            android:id="@+id/disconnectBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Disconnect &amp; cleanup" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Diagnostics (also logged to app-scoped file):"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/logView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true"
            android:typeface="monospace"
            android:textSize="12sp"
            android:text="(log)" />

    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="SectionLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">22dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">#6B7280</item>
    </style>

    <style name="BodyText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">#111827</item>
    </style>

    <style name="MonoText" parent="BodyText">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>

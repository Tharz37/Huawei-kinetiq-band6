<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F7"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#111827"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/subtitle"
            android:textColor="#4B5563"
            android:textSize="13sp" />

        <!-- Receiver configuration -->
        <TextView style="@style/SectionLabel" android:text="@string/section_receiver" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/label_endpoint"
            android:textColor="#374151"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/endpointInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_endpoint"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLines="1"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/label_token"
            android:textColor="#374151"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/tokenInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:maxLines="1"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/saveButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/save" />

            <Button
                android:id="@+id/testButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/test_connection" />
        </LinearLayout>

        <TextView
            android:id="@+id/testResult"
            style="@style/BodyText"
            android:text="@string/not_tested"
            android:textColor="#374151" />

        <!-- Accessibility -->
        <TextView style="@style/SectionLabel" android:text="@string/section_service" />

        <TextView
            android:id="@+id/accessibilityStatus"
            style="@style/BodyText"
            android:text="@string/status_unknown"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/openAccessibilityButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/open_accessibility" />

            <Button
                android:id="@+id/openHealthButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/open_health" />
        </LinearLayout>

        <!-- Streaming -->
        <TextView style="@style/SectionLabel" android:text="@string/section_streaming" />

        <TextView
            android:id="@+id/streamingStatus"
            style="@style/BodyText"
            android:text="@string/status_unknown"
            android:textStyle="bold" />

        <Button
            android:id="@+id/serviceToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/start_streaming" />

        <!-- Last result -->
        <TextView style="@style/SectionLabel" android:text="@string/section_last" />

        <TextView
            android:id="@+id/lastValues"
            style="@style/MonoText"
            android:text="@string/no_reading" />

        <TextView
            android:id="@+id/lastTime"
            style="@style/BodyText"
            android:textColor="#4B5563" />

        <TextView
            android:id="@+id/lastResult"
            style="@style/BodyText"
            android:textColor="#4B5563" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/demo_hint"
            android:textColor="#6B7280"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KinetiQ Bridge — Huawei Band 6"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:background="#FFF3CD"
            android:padding="10dp"
            android:layout_marginTop="12dp"
            android:text="status message" />

        <TextView
            android:id="@+id/hmsState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="HMS Health Kit: …" />

        <TextView
            android:id="@+id/permState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="permission: …" />

        <TextView
            android:id="@+id/lastReading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:text="No genuine reading yet." />

        <TextView
            android:id="@+id/laptopState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="laptop: …" />

        <Button
            android:id="@+id/authBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="1 · Authorise Health Kit access" />

        <Button
            android:id="@+id/startStopBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2 · Start heart-rate" />

        <Button
            android:id="@+id/spo2Btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3 · Query latest SpO2 (one-shot)" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Laptop receiver (trusted Wi-Fi only)"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/urlInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="http://192.168.1.20:8000"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/tokenInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="shared token (from laptop backend/config.json)"
            android:inputType="textPassword" />

        <Button
            android:id="@+id/saveBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save laptop connection" />

    </LinearLayout>
</ScrollView>
